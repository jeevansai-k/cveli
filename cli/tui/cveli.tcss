/* CVELI — Opus 5.5 design system (Textual CSS).
 * Colours come exclusively from theme tokens defined in cli/tui/theme.py.
 * Never add literal colours here: tests/test_foundations.py enforces it.
 */

Screen {
    background: $background;
    color: $foreground;
}

/* ---------- Clean boundaries ---------------------------------------------
 * Textual's default "tall" borders and 2-column scrollbars are drawn with
 * half-block glyphs (▊ ▎ ▐ ▌) that many terminal fonts render shifted by a
 * fraction of a cell, so edges look like they wobble left and right. Use
 * box-drawing borders and solid 1-column scrollbars everywhere instead, and
 * change only the *colour* on focus so nothing moves.
 */
* {
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    scrollbar-color: $border;
    scrollbar-color-hover: $primary;
    scrollbar-color-active: $primary;
    scrollbar-corner-color: $surface;
}
Input, TextArea, OptionList, DataTable, RadioSet, Switch, Checkbox,
SelectCurrent, SelectOverlay {
    border: round $border;
}
Input:focus, TextArea:focus, OptionList:focus, DataTable:focus, RadioSet:focus,
Switch:focus, Checkbox:focus, Select:focus > SelectCurrent,
Select.-expanded > SelectCurrent {
    border: round $focus-ring;
    background-tint: $background 0%;
}
Button:focus, Button:hover {
    background-tint: $background 0%;
}
RadioSet > RadioButton {
    border: none;
    background: $background;
}
/* Controls share the page background so only the border line is visible
 * (box-drawing lines sit mid-cell; a different fill would show as a halo). */
Input, TextArea, OptionList, DataTable, RadioSet, Switch, Checkbox,
SelectCurrent, Button {
    background: $background;
}
Checkbox {
    height: 3;
    padding: 0 1;
}
Button.-primary {
    background: $primary;
    color: $background;
}
Button.-warning {
    background: $warning;
    color: $background;
}
Button.-error {
    background: $error;
    color: $background;
}
Button {
    border: round $border;
}
Button:hover {
    border: round $primary;
}
Button:focus {
    border: round $focus-ring;
}
Button.-primary {
    border: round $primary;
}
Button.-warning {
    border: round $warning;
}
Button.-error {
    border: round $error;
}
Button:disabled {
    border: round $border;
}

/* ---------- Command bar ------------------------------------------------- */
#command_bar {
    height: 3;
    dock: top;
    background: $surface;
    border-bottom: solid $border;
    padding: 0 1;
}
#command_bar #app_title {
    width: auto;
    padding: 1 2 0 0;
    color: $primary;
    text-style: bold;
}
#command_bar #global_search {
    width: 1fr;
    border: round $border;
    background: $surface;
}
#command_bar #global_search:focus {
    border: round $focus-ring;
}
#command_bar #source_status {
    width: auto;
    max-width: 48;
    padding: 1 0 0 2;
    color: $text-muted;
}

/* ---------- Layout ------------------------------------------------------ */
#body {
    height: 1fr;
}
#nav {
    border: none;
    border-right: solid $border;
    width: 24;
    background: $surface;
    border-right: solid $border;
    padding: 1 0;
}
#nav:focus {
    border-right: solid $focus-ring;
}
#workspace {
    width: 1fr;
    padding: 0 1;
}
#intel {
    width: 36;
    background: $surface;
    border-left: solid $border;
    padding: 1 2;
}
.-hidden {
    display: none;
}

/* Responsive breakpoints (App.HORIZONTAL_BREAKPOINTS) */
Screen.-narrow #intel,
Screen.-medium #intel {
    display: none;
}
Screen.-medium #intel.-pinned {
    display: block;
}
Screen.-narrow #nav {
    width: 10;
}
Screen.-narrow #command_bar #source_status,
Screen.-narrow #command_bar #app_title {
    display: none;
}

/* ---------- Typography -------------------------------------------------- */
.view-title {
    text-style: bold;
    color: $foreground;
    padding: 1 0 0 0;
}
.view-subtitle,
.muted {
    color: $text-muted;
}
.section-title {
    text-style: bold;
    color: $primary;
    padding: 1 0 0 0;
}
.label {
    color: $text-muted;
    text-style: bold;
}
.mono {
    text-style: none;
}

/* ---------- Brand ------------------------------------------------------- */
.brand {
    content-align: center middle;
    color: $primary;
    text-style: bold;
    height: auto;
    padding: 1 0;
}

/* ---------- Cards / panels --------------------------------------------- */
.card {
    background: $surface;
    border: round $border;
    padding: 0 1;
    margin: 1 0 0 0;
    height: auto;
}
.card:focus-within {
    border: round $focus-ring;
}
.card-row {
    height: auto;
}
#stat_row {
    layout: grid;
    grid-size: 6;
    grid-gutter: 0 1;
    height: auto;
}
Screen.-narrow #stat_row,
Screen.-medium #stat_row {
    grid-size: 3;
}
.stat-card {
    width: 1fr;
    height: 5;
    background: $surface;
    border: round $border;
    padding: 0 1;
    content-align: center middle;
}

/* ---------- Badges ------------------------------------------------------ */
.badge {
    width: auto;
    height: 1;
    padding: 0 1;
    margin-right: 1;
    text-style: bold;
}
.sev-critical { color: $sev-critical; }
.sev-high { color: $sev-high; }
.sev-medium { color: $sev-medium; }
.sev-low { color: $sev-low; }
.sev-none { color: $sev-none; }
.label-research { color: $secondary; }
.label-poc { color: $warning; }
.label-unverified { color: $text-muted; }
.label-patch { color: $success; }
.risk-low { color: $success; }
.risk-medium { color: $warning; }
.risk-high { color: $error; }

/* ---------- Notices / states ------------------------------------------- */
.notice {
    border-left: heavy $warning;
    background: $surface;
    padding: 0 1;
    margin: 1 0 0 0;
    height: auto;
    color: $foreground;
}
.notice-info {
    border-left: heavy $accent;
}
EmptyState, ErrorState {
    height: auto;
    border: round $border;
    padding: 1 2;
    margin: 1 0;
}
ErrorState {
    border: round $error;
}
ErrorState .state-title {
    color: $error;
    text-style: bold;
}
EmptyState .state-title {
    text-style: bold;
}
LoadingIndicator {
    height: 3;
    color: $primary;
}

/* ---------- Form controls ---------------------------------------------- */
Button {
    margin-right: 1;
    min-width: 10;
}
Button:focus {
    text-style: bold;
}
.form-row {
    height: auto;
    margin: 1 0 0 0;
}
.form-row > Input {
    width: 1fr;
}
.form-row > Label, .form-row > .label {
    padding: 1 1 0 0;
    width: auto;
}
.field {
    width: 1fr;
    min-width: 14;
    height: auto;
    margin-right: 1;
}
.form-row > Select {
    width: 28;
    margin-right: 1;
}
.form-row > Checkbox {
    width: auto;
    margin-right: 1;
}
.form-row > Static {
    width: 1fr;
    height: auto;
    padding: 1 0 0 1;
}
/* Checkbox subclasses Static; keep it a normal 3-row bordered control. */
.form-row > Checkbox, #export_formats > Checkbox {
    width: auto;
    height: 3;
    padding: 0 1;
}
/* result / state slots size to their content */
#cve_state, #edb_state, #dork_preview, #tpl_result {
    height: auto;
}
#tpl_screen_body > TemplatePreview, TemplatePreview {
    height: auto;
}
TabbedContent {
    height: auto;
}

/* ---------- Tables ------------------------------------------------------ */
DataTable {
    height: 1fr;
    min-height: 6;
    border: round $border;
}
#results_table {
    height: 1fr;
    margin: 0 1;
}

/* ---------- Code blocks ------------------------------------------------- */
CodeBlock {
    height: auto;
    max-height: 30;
    border: round $border;
    margin: 1 0 0 0;
}
CodeBlock TextArea {
    height: auto;
    max-height: 26;
    border: none;
}
CodeBlock .codeblock-bar {
    height: 1;
    background: $panel;
    padding: 0 1;
}
CodeBlock .codeblock-bar Static {
    width: 1fr;
    color: $text-muted;
}
CodeBlock .codeblock-bar Button {
    height: 1;
    min-width: 8;
    border: none;
}

/* ---------- Modals ------------------------------------------------------ */
ConfirmModal, ProjectPickerModal, CVEDetailModal {
    align: center middle;
    background: $background 60%;
}
ConfirmModal > #dialog, ProjectPickerModal > #dialog, CVEDetailModal > Container {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    background: $surface;
    border: heavy $warning;
    padding: 1 2;
}
ConfirmModal #dialog_buttons, ProjectPickerModal #dialog_buttons {
    height: auto;
    margin-top: 1;
}
ConfirmModal #export_formats {
    height: auto;
}
ConfirmModal #export_formats > Checkbox {
    width: auto;
    margin-right: 1;
}
ProjectPickerModal #project_choices {
    height: auto;
    max-height: 12;
}
ProjectPickerModal #new_project_row {
    height: auto;
}
ProjectPickerModal #new_project_name {
    width: 1fr;
}

/* ---------- Search results browser (cveli search) ----------------------- */
#search_title {
    content-align: center middle;
    padding: 1 0 0 0;
    text-style: bold;
}
#search_summary, #search_help, #search_message, #source_note {
    padding: 0 1;
}
#source_note {
    color: $text-muted;
}
#search_help {
    color: $primary;
    text-style: bold;
}
#search_message {
    color: $warning;
    min-height: 1;
}
#empty_state {
    border: round $border;
    display: none;
    height: auto;
    margin: 1;
    padding: 1 2;
}
#selection_input {
    margin: 0 1;
}
.detail_shell {
    height: 1fr;
    padding: 1;
}
.detail_header {
    border: round $accent;
    padding: 0 1;
    margin-bottom: 1;
    text-style: bold;
}
.detail_top {
    height: auto;
}
.detail_column {
    width: 1fr;
    height: auto;
    border: round $border;
    padding: 0 1;
    margin-right: 1;
}
.detail_section {
    border: round $border;
    padding: 0 1;
    margin-top: 1;
    height: auto;
}
.section_title {
    text-style: bold;
    color: $primary;
}
.detail_help {
    padding-top: 1;
    color: $text-muted;
}
.reference_row {
    height: auto;
    padding: 0;
}
.reference_row > Static {
    width: auto;
    padding-right: 1;
}
Link {
    color: $accent;
    text-style: underline;
}
Link:focus {
    text-style: bold underline reverse;
}

/* ---------- Footer ------------------------------------------------------ */
Footer {
    background: $surface;
}
