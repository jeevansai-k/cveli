# CVE Sentinel Environment Variables
# Copy this file to .env and fill in your values

# API Keys (if any)
NVD_API_KEY=
CVE_ORG_API_KEY=

# Rate Limits (requests per minute)
RATE_LIMIT_NVD=60
RATE_LIMIT_CVE_ORG=30

# Sync Settings
SYNC_INTERVAL_MINUTES=1440  # Default: once daily
MAX_CONCURRENT_REQUESTS=5

# Logging
LOG_LEVEL=INFO
