# CVELI Environment Variables
# Copy this file to .env and fill in your values

# NIST NVD API Key (Recommended for higher rate limits)
NVD_API_KEY=

# CVE.org API Key (Optional)
CVE_ORG_API_KEY=

# Rate Limits (requests per minute)
RATE_LIMIT_NVD=60
RATE_LIMIT_CVE_ORG=30

# Sync Settings
SYNC_INTERVAL_MINUTES=1440  # Default: once daily
MAX_CONCURRENT_REQUESTS=5

# Custom Storage & Logging Paths (Optional)
CVELI_DB_PATH=storage/cveli.db
CVELI_CACHE_DIR=.cache/cveli
CVELI_LOG_LEVEL=INFO
