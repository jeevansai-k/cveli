# CVELI 2.0 configuration — copy to .env (current directory) or
# ~/.config/cveli/.env. Real environment variables always take precedence.

# --- API keys ---------------------------------------------------------------
# NIST NVD API key (recommended: raises the limit from 5 to 50 requests / 30 s)
NVD_API_KEY=
# CVE.org API key (optional)
CVE_ORG_API_KEY=

# --- Storage (defaults follow the XDG base directory spec) -----------------
# CVELI_DATA_DIR=~/.local/share/cveli
# CVELI_DB_PATH=~/.local/share/cveli/cveli.db
# CVELI_CACHE_DIR=~/.cache/cveli
# CVELI_LOG_DIR=~/.cache/cveli/logs
# CVELI_CACHE_SIZE_MB=256
CVELI_LOG_LEVEL=INFO

# --- Network ----------------------------------------------------------------
# CVELI_HTTP_TIMEOUT=30
# CVELI_HTTP_RETRIES=3

# --- Freshness (hours / seconds) --------------------------------------------
# CVELI_KEV_TTL_HOURS=24
# CVELI_EXPLOITDB_TTL_HOURS=24
# CVELI_SEARCH_CACHE_TTL=3600
# CVELI_EPSS_BATCH=100

# --- Exploit-DB ---------------------------------------------------------------
# Local exploitdb checkout or files_exploits.csv for offline use
# EXPLOITDB_PATH=/usr/share/exploitdb
# EXPLOITDB_URL=https://gitlab.com/exploit-database/exploitdb/-/raw/main/files_exploits.csv

# --- Feature flags ------------------------------------------------------------
# CVELI_FEATURE_EXPLOITDB=1
# CVELI_FEATURE_DORKS=1
# CVELI_FEATURE_MSF=1

# --- Dork Builder browser-open limits ----------------------------------------
# CVELI_DORK_OPEN_INTERVAL=5
# CVELI_DORK_OPEN_PER_HOUR=30

# --- Appearance & privacy -----------------------------------------------------
# CVELI_THEME=auto            # dark | light | auto
# CVELI_REDUCE_MOTION=0
# CVELI_METRICS=1             # local-only metrics; nothing is sent anywhere
# CVELI_METRICS_RETENTION_DAYS=30
# CVELI_AUDIT_RETENTION_DAYS=90
